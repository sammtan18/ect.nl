&lt;p&gt;&lt;a data-entity-substitution="media" data-entity-type="media" data-entity-uuid="59b69498-aa79-4312-af35-acb655f19044" href="https://www.ect.nl/sites/d10p.ect.nl/files/2025-08/20250826_ect_wechselt_zur_gesichtserkennung_auf_der_cargocard_-_2_webbericht_0.docx" target="_blank" title="20250826_ect_wechselt_zur_gesichtserkennung_auf_der_cargocard_-_2_webbericht.docx"&gt;Deutsch&lt;/a&gt;&lt;/p&gt;
